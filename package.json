{
  "name": "openflashcef",
  "version": "1.0.0",
  "description": "A new age for animation",
  "main": "electron.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "package": "npm run build && electron-packager . OpenFlash --platform=win32 --arch=x64 --out=dist_electron --icon=build/file.ico --overwrite"
  },
  "dependencies": {
    "@spectrum-web-components/bundle": "^1.12.4",
    "@spectrum-web-components/styles": "^1.12.4",
    "@spectrum-web-components/theme": "^1.12.4",
    "jszip": "^3.10.2"
  },
  "devDependencies": {
    "@electron/packager": "^18.3.3",
    "concurrently": "^8.2.2",
    "electron": "^33.0.0",
    "vite": "^5.0.0",
    "wait-on": "^7.2.0"
  }
}
